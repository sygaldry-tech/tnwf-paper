# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/
*.nbconvert.ipynb

# uv
.venv/
# NOTE: uv.lock IS tracked in this release (reproducible deps + license review).

# Generated outputs (regenerate with the scripts under scripts/).
# Anchored to the repo root so the src/tnwf/data and tests/data PACKAGES are
# still tracked.
/results/
# `/data/*` rather than `/data/` so a specific file can be re-included below;
# git will not descend into a wholly excluded directory, so a negation under
# `/data/` alone has no effect.
/data/*
/figures/
/inputs/
/logs/

# Local example/figure artifacts
*.png
*.pdf
*.npz
*.pt
*.pkl
*.amat
# ...but the committed README/doc assets and the demo MPS-V checkpoint are tracked.
!assets/
!assets/**
!examples/checkpoints/
!examples/checkpoints/**
# Table-2 (K=160, D_max=64) MPS cores backing the rare-event figure. Converted
# from the original pickles to .npz so this repository ships no pickle payloads.
!examples/rare_event/
!examples/rare_event/**
# Target--target finite-sample SW floor: a 1 KB required input for Table 1, not
# bulk data. The sweeps it accompanies ship separately; this is small enough and
# tied closely enough to the generator to live in the repo.
!/data/exact_sw_floor.json
# Coordinate-convention table for artifacts that carry no in-file stamp. Source,
# not data: tnwf.coords reads it to decide whether a file's sample coordinates
# still need the half-cell correction.
!/data/COORD_CONVENTIONS.tsv

# OS
.DS_Store

# Editors
.vscode/
.idea/
*.code-workspace

# Local rare-event QAE bridge (separate workstream; internal paths, do not ship)
scripts/gmm_8d_rare_event/

# Local QTT / quantics workstream (separate workstream; do not ship).
# The public release deliberately excludes the binary-folded QTT path — see the
# NotImplementedError in src/tnwf/mps_v/model.py. Keep these untracked so that
# exclusion stays true.
src/tnwf/qtt/
tests/mps/test_qtt_layer.py
scripts/exploration/
